<!doctype html>
<html lang="{{ lang }}">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}" />
  <link rel="stylesheet" href="/style.css" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate icon" href="/apple-touch-icon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="alternate" type="application/atom+xml" title="Javier — Blog"
        href="{{ '/en/feed.xml' if lang == 'en' else '/feed.xml' }}" />

  {% set esUrl = page.url if lang == 'es' else otherLangUrl %}
  {% set enUrl = page.url if lang == 'en' else otherLangUrl %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}" />
  <link rel="alternate" hreflang="es" href="{{ site.url }}{{ esUrl }}" />
  <link rel="alternate" hreflang="en" href="{{ site.url }}{{ enUrl }}" />
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ esUrl }}" />
</head>

<body>
  <div class="wrap">
    <header class="site-header">
      <div class="brand-wrap">
        <div class="brand-row">
          <a class="brand" href="{{ '/en/' if lang == 'en' else '/' }}">Javier</a>
          <nav class="top-nav" aria-label="{{ site.strings[lang].navAria }}">
            {% for cat in taxonomy.categories %}
            <a href="{{ '/en/' if lang == 'en' else '/' }}#{{ cat.id }}">{{ cat.label[lang] }}</a>
            {% endfor %}
            <a href="{{ site.portfolioUrl }}" target="_blank" rel="noopener" class="nav-external">{{ site.strings[lang].portfolio }}</a>
          </nav>
        </div>

        <p class="subtitle">{{ site.strings[lang].subtitle }}</p>

        {% if isHome %}
        <p class="lede" data-reveal>{{ site.strings[lang].lede }}</p>
        <div class="lang-switch">
          <a href="/" data-lang="es" class="{{ 'active' if lang == 'es' }}">ES</a>
          <span class="sep">|</span>
          <a href="/en/" data-lang="en" class="{{ 'active' if lang == 'en' }}">EN</a>
        </div>
        {% endif %}
      </div>
    </header>

    {{ content | safe }}

    <footer class="site-footer">
      <p class="muted">
        © 2026 Javier ·
        <a href="{{ '/en/feed.xml' if lang == 'en' else '/feed.xml' }}">RSS</a>
      </p>
      {% if isHome %}
      <p class="muted">
        {{ site.strings[lang].workCv }}
        <a href="{{ site.portfolioUrl }}" target="_blank" rel="noopener">{{ site.strings[lang].portfolio }}</a>
      </p>
      {% endif %}
    </footer>
  </div>

  {% if isPost or isHome %}
  <script src="/giscus.js" defer></script>
  {% endif %}

  <script data-goatcounter="{{ site.goatcounter }}"
          async src="//gc.zgo.at/count.js"></script>
  <noscript>
    <img src="{{ site.goatcounter }}?p=/noscript" alt="">
  </noscript>

  <script>
    (function () {
      var reduced = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      // El texto de cada post también aparece con el scroll, párrafo a párrafo.
      var postContent = document.querySelector(".post-content");
      if (postContent) {
        Array.prototype.forEach.call(postContent.children, function (el) {
          el.setAttribute("data-reveal", "");
        });
      }

      if (!reduced && "IntersectionObserver" in window) {
        var els = document.querySelectorAll("[data-reveal]");
        els.forEach(function (el) {
          var group = el.closest("[data-reveal-group]");
          if (group) {
            var siblings = Array.prototype.slice.call(group.querySelectorAll("[data-reveal]"));
            var i = siblings.indexOf(el);
            if (i > 0) el.style.transitionDelay = Math.min(i, 4) * 70 + "ms";
          }
          el.classList.add("reveal");
        });

        var observer = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.1, rootMargin: "0px 0px -8% 0px" });

        els.forEach(function (el) { observer.observe(el); });
      }

      // Archivo: anima el alto al abrir/cerrar cada <details> en vez del salto nativo.
      if (!reduced) {
        document.querySelectorAll(".section-block").forEach(function (details) {
          var summary = details.querySelector("summary");
          var list = details.querySelector(".section-block-list");
          if (!summary || !list || !details.animate) return;

          var anim = null;
          var busy = false;

          summary.addEventListener("click", function (e) {
            e.preventDefault();
            if (busy) return;
            details.open ? collapse() : expand();
          });

          function expand() {
            busy = true;
            details.style.overflow = "hidden";
            details.open = true;
            var end = summary.offsetHeight + list.offsetHeight;
            if (anim) anim.cancel();
            anim = details.animate(
              { height: [summary.offsetHeight + "px", end + "px"] },
              { duration: 260, easing: "ease-out" }
            );
            anim.onfinish = function () { finish(); };
          }

          function collapse() {
            busy = true;
            var start = details.offsetHeight;
            details.style.overflow = "hidden";
            if (anim) anim.cancel();
            anim = details.animate(
              { height: [start + "px", summary.offsetHeight + "px"] },
              { duration: 220, easing: "ease-out" }
            );
            anim.onfinish = function () {
              details.open = false;
              finish();
            };
          }

          function finish() {
            details.style.height = "";
            details.style.overflow = "";
            busy = false;
          }
        });
      }
    })();
  </script>
</body>
</html>
