{% import "components/postcard.njk" as postcard with context %}

<main class="home">
  <section class="home-section" aria-label="{{ site.strings[lang].featuredTitle }}">
    <div class="section-head">
      <h2 class="section-title">{{ site.strings[lang].featuredTitle }}</h2>
      <p class="section-sub">{{ site.strings[lang].featuredSub }}</p>
    </div>

    {% set bigs = [] %}
    {% set smalls = [] %}
    {% for f in featuredPosts %}
      {% if f.size == "big" %}{% set _ = bigs.push(f.post) %}{% else %}{% set _ = smalls.push(f.post) %}{% endif %}
    {% endfor %}
    {% set featuredFlat = bigs.concat(smalls) %}

    <div class="featured-grid">
      <div class="featured-hero">
        {% for p in bigs %}{{ postcard.card(p, lang, true) }}{% endfor %}
      </div>
      <div class="featured-side">
        {% for p in smalls %}{{ postcard.card(p, lang, false) }}{% endfor %}
      </div>
    </div>
  </section>

  <section class="home-section" aria-label="{{ site.strings[lang].recentTitle }}">
    <div class="section-head">
      <h2 class="section-title">{{ site.strings[lang].recentTitle }}</h2>
      <p class="section-sub">{{ site.strings[lang].recentSub }}</p>
    </div>

    <div class="recent-list">
      {% for p in (posts | excludeFrom(featuredFlat)).slice(0, 10) %}
      <a class="recent-row" href="{{ p.url }}">
        <div class="recent-left">
          <div class="recent-title">{{ p.data.title }}</div>
          <div class="recent-sub">{{ p.data.category | categoryLabel(lang) }}</div>
        </div>
        <div class="recent-date">{{ p.data.date | formatDate(lang) }}</div>
      </a>
      {% endfor %}
    </div>
  </section>

  <section class="home-section" aria-label="{{ site.strings[lang].archiveTitle }}">
    <div class="section-head">
      <h2 class="section-title">{{ site.strings[lang].archiveTitle }}</h2>
      <p class="section-sub">{{ site.strings[lang].archiveSub }}</p>
    </div>

    <div class="section-blocks">
      {% for cat in taxonomy.categories %}
      {% set items = posts | byCategory(cat.id) %}
      {% if items.length %}
      <details id="{{ cat.id }}" class="section-block">
        <summary class="section-block-head">
          <h3 class="section-block-title">{{ cat.label[lang] }}</h3>
        </summary>
        <ul class="section-block-list">
          {% for p in items %}
          <li><a href="{{ p.url }}">{{ p.data.title }}</a> <span class="muted">· {{ p.data.date | formatDate(lang) }}</span></li>
          {% endfor %}
        </ul>
      </details>
      {% endif %}
      {% endfor %}
    </div>
  </section>

  <section class="home-section" aria-label="{{ site.strings[lang].subscribeTitle }}">
    <div class="section-head">
      <h2 class="section-title">{{ site.strings[lang].subscribeTitle }}</h2>
      <p class="section-sub">{{ site.strings[lang].subscribeSub }}</p>
    </div>

    <div class="subscribe-card">
      <form action="{{ site.buttondown.action }}" method="post" class="subscribe-form">
        <label for="bd-email" class="sr-only">{{ site.strings[lang].subscribeLabel }}</label>
        <input type="email" name="email" id="bd-email" placeholder="{{ site.strings[lang].subscribeLabel }}" required />
        <button type="submit">{{ site.strings[lang].subscribeButton }}</button>
      </form>
      <p class="subscribe-note muted">
        <a href="{{ site.buttondown.referUrl }}" target="_blank" rel="noopener">{{ site.strings[lang].subscribePowered }}</a>
      </p>
    </div>
  </section>

  <section class="home-section" aria-label="{{ site.strings[lang].comments }}">
    <div class="section-head">
      <h2 class="section-title">{{ site.strings[lang].comments }}</h2>
      <p class="section-sub">{{ site.strings[lang].commentsSub }}</p>
    </div>

    <div class="comments-card">
      <div class="comments-host"></div>
    </div>
  </section>
</main>

<script>
  (function () {
    var openTarget = function () {
      var el = document.getElementById(location.hash.slice(1));
      if (el && el.tagName === "DETAILS") {
        el.open = true;
        el.scrollIntoView({ block: "start" });
      }
    };
    if (location.hash) openTarget();
    window.addEventListener("hashchange", openTarget);
  })();
</script>
